# --- MongoDB (read-only service user, D13) ---
MONGO_URI=mongodb+srv://ops-check-ro:<password>@<cluster>/
MONGO_DB=bmo_dataviewer

# Registry = the existing `vessels` collection (D13), no extra columns.
# Folder name on the shares; default `vesselname` (e.g. Aberdaron_Bay).
VESSEL_FIELD_SYSTEM=vesselname
# Known cases (demob, tablet-only, ...) and priority vessels: config/vessels.toml
VESSELS_CONFIG=config/vessels.toml

# --- File shares (D15/D16) ---
LANDING_DIR=/Volumes/FTP_VESSEL_DATA
STAGING_DIR=/Volumes/Raw_vessel_data2
PROCESSED_DIR=/Volumes/vessel_data6
# Scheduled runs mount these first if they aren't mounted (read-only account, password in the Keychain).
# Space separated; the last part of each URL must match the folder name under /Volumes.
SHARE_URLS="smb://<ro-user>@<server>/FTP_VESSEL_DATA smb://<ro-user>@<server>/Raw_vessel_data2 smb://<ro-user>@<server>/vessel_data6"

# --- Thresholds (tuned from the parallel-run logs, D16) ---
MOVER_STUCK_HOURS=6
PROCESSING_DEADLINE=11:00
TRANSIT_GAP_MINUTES=60
REGISTRY_STALE_HOURS=0   # off: lastModified is not a sync timestamp

# --- Output ---
RESULTS_DIR=./results
TEAMS_WEBHOOK_URL=
WATCHDOG_WEBHOOK_URL=
TIMEZONE=Europe/Amsterdam
