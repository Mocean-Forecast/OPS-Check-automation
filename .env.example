# --- MongoDB (read-only service user, D13) ---
MONGO_URI=mongodb+srv://ops-check-ro:<password>@<cluster>/
MONGO_DB=bmo_dataviewer

# Field names in the `vessels` collection. The new registry columns (D13) don't exist yet;
# set these once they are added to the Vessel & field Excel and carried by the sync.
VESSEL_FIELD_SYSTEM=systemName
VESSEL_FIELD_STATUS=opsStatus
VESSEL_FIELD_STATUS_REASON=opsStatusReason
VESSEL_FIELD_STATUS_OWNER=opsStatusOwner
VESSEL_FIELD_STATUS_EXPIRY=opsStatusExpiry
VESSEL_FIELD_PRIORITY=priority
VESSEL_FIELD_SYNCED_AT=lastSynced

# --- File shares (D15/D16) ---
LANDING_DIR=/mnt/bmo/FTP_VESSEL_DATA
STAGING_DIR=/mnt/bmo/Raw_vessel_data2
PROCESSED_DIR=/mnt/bmo/vessel_data6

# --- Thresholds (tuned from the parallel-run logs, D16) ---
MOVER_STUCK_HOURS=6
PROCESSING_DEADLINE=11:00
TRANSIT_GAP_MINUTES=60
REGISTRY_STALE_HOURS=26

# --- Output ---
RESULTS_DIR=./results
TEAMS_WEBHOOK_URL=
WATCHDOG_WEBHOOK_URL=
TIMEZONE=Europe/Amsterdam
